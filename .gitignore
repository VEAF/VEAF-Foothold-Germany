# Toolchain, deployed by veaf-tools-updater — not versioned.
veaf-tools.exe
veaf-tools-updater.exe
published/

# Build output.
*.miz
missions/
temp/
*.log

# Reports produced by build/validate.
presets-validation-report.md
convert-other-report.md

# Generated by `veaf-tools build` from mission.yaml — never edited by hand, so never
# versioned: a stale copy in git would contradict mission.yaml, which is the source.
src/scripts/veaf-config.lua
src/scripts/veaf-config-override.lua
src/scripts/veafDynamicConfig.lua
